{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asdl-docs",
  "compatibility_date": "2026-09-27",
  // Static site: Cloudflare serves the Starlight build output directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "docs.asdl.website", "custom_domain": true }],
  "workers_dev": false
}
